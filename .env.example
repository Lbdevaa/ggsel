# Скопировать в .env перед запуском: cp .env.example .env

# API (backend)
PORT=3300
DB_PATH=./backend/data/app.sqlite
ADMIN_TOKEN=admin-dev-token

# Поставщики выдачи
SUPPLIER_A_URL=http://localhost:4001
SUPPLIER_B_URL=http://localhost:4002
SUPPLIER_TIMEOUT_MS=3000
SUPPLIER_MAX_RETRIES=3

# Заглушки поставщиков (доля ошибок и таймаутов, 0..1)
SUPPLIER_FAIL_RATE=0
SUPPLIER_TIMEOUT_RATE=0
SUPPLIER_HANG_MS=10000
